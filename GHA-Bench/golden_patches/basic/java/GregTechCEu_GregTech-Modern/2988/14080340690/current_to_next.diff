+public record MaterialEntry(@NotNull TagPrefix tagPrefix, @NotNull Material material) {
+
+    public static final MaterialEntry NULL_ENTRY = new MaterialEntry(TagPrefix.NULL_PREFIX, GTMaterials.NULL);
+
